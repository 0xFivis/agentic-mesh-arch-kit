# REFERENCE ONLY: sanitized sample, not for production
# .github/workflows/release.yml
name: release

on:
  push:
    tags: ['v*.*.*']

jobs:
  release:
    runs-on: ubuntu-latest
    permissions:
      contents: write
      packages: write
    steps:
      - uses: actions/checkout@v4
      - name: Read VERSION
        run: |
          ver=$(cat VERSION 2>/dev/null || echo "${GITHUB_REF_NAME#v}")
          echo "RELEASE_VER=$ver" >> "$GITHUB_ENV"
      - name: Build all services
        run: make build
      - name: Publish images
        run: echo "TODO: docker push per service (registry placeholder)"
      - name: GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          generate_release_notes: true
